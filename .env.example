# Backend Configuration Example
# Copy this to .env and customize for your environment

PROJECT_NAME="Student Performance Analytics & Early-Warning API"
ENVIRONMENT=development
DEBUG=True

# Security & JWT
# Generate a strong key in production using: openssl rand -hex 32
SECRET_KEY=dev_secret_key_change_in_production_89ed61c073244866
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Connection (SQLite default, can be Postgres or MySQL)
DATABASE_URL=sqlite:///./data/student_performance.db

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:3000

# File Upload Settings
MAX_UPLOAD_SIZE_MB=25
